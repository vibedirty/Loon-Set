[Rewrite]
^https:\/\/m\.pinduoduo\.net\/tandy_vase\.html\?.*$ response-body-replace-regex ((?:10:00|16:00|21:00))开抢 $1准备好了吗
^https:\/\/m\.pinduoduo\.net\/tandy_vase\.html\?.*$ response-body-replace-regex "couponType":2 "couponType":0

[Script]
http-response ^https:\/\/m\.pinduoduo\.net\/tandy_vase\.html\?.*$ script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/loon_tandy_vase_auto_click_inject.js, requires-body=true, tag=自动点击注入

[MITM]
hostname = m.pinduoduo.net
