# @file-type loon-plugin
# update at 2026-10-21 12:17

#!name=拼多多工具箱
#!desc=优惠券自动确认与整点自动解锁抢券，需启用 MITM 并保持页面打开。
#!author=Codex
#!tag=薅羊毛
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png

[Script]
http-response ^https:\/\/m\.pinduoduo\.net\/tandy_vase\.html\?.*$ script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/tandy_vase_inject.js, requires-body=true, tag=自动点击注入

http-response ^https:\/\/(?:m\.pinduoduo\.net|mobile\.yangkeduo\.com)\/attendance\.html\?(?:[^&]*&)*id=197270(?:&.*)?$ script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/hour-coupon-auto.js, requires-body=true, tag=整点抢券页面注入

[MITM]
hostname = m.pinduoduo.net, mobile.yangkeduo.com
