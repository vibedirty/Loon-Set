#!name=自习自动预约
#!desc=设备时区须为 Asia/Shanghai。
#!author=Codex

[Script]
http-request ^https:\/\/cloud\.macken-tech\.com\/api\/.*[?&]app_id=wx825445b915377a7f(?:&|$) script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/zixi-reserve.js, requires-body=false, timeout=10, tag=麦肯自习登录信息
cron "0 0 6 * * *" script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/zixi-reserve.js, timeout=180, tag=麦肯自习次日预约, enable=true

[MITM]
hostname = cloud.macken-tech.com
