# @file-type loon-plugin
# update at 2026-10-30 12:32

#!name=自习自动预约
#!desc=设备时区须为 Asia/Shanghai。
#!author=Codex

[Script]
generic script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/zixi-reserve.js, argument="check", timeout=120, tag=麦肯自习预约自检
http-request ^https:\/\/cloud\.macken-tech\.com\/api\/user\?(?:[^&]*&)*app_id=wx825445b915377a7f(?:&.*)?$ script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/zixi-reserve.js, requires-body=false, timeout=10, tag=麦肯自习登录信息, enable=false
cron "1 0 6 * * *" script-path=https://raw.githubusercontent.com/vibedirty/Loon-Set/main/script/zixi-reserve.js, timeout=180, tag=麦肯自习次日预约, enable=true

[MITM]
hostname = cloud.macken-tech.com
